# SPDX-License-Identifier: GPL-2.0
#
# Kbuild.include — 构建辅助宏
#
# 原理：
#   构建系统使用 quiet_cmd_* / cmd_* 对和 $(call cmd,<name>)
#   宏来实现"短输出 + 完整命令"的双模输出。
#
#   每个构建步骤定义两个变量：
#     quiet_cmd_<name> = CC      $@        # 短输出（V=0 时显示）
#           cmd_<name> = $(CC) $(CFLAGS) ... # 完整命令（V=1 时显示）
#
#   调用 $(call cmd,<name>) 时：
#     V=0（默认）：只打印 quiet_cmd_<name> 定义的内容
#     V=1       ：回显完整命令

# 转义单引号（用于 echo 语句）
squote  := '
escsq = $(subst $(squote),'\$(squote)',$1)

# ========== 详细模式控制 ==========
# make V=1 显示完整编译命令
quiet = quiet_
Q = @

ifeq ("$(origin V)", "command line")
  KBUILD_VERBOSE = $(V)
endif

ifneq ($(findstring 1, $(KBUILD_VERBOSE)),)
  quiet =
  Q =
endif

# make -s（完全静默）时关闭所有输出
ifneq ($(findstring s,$(firstword -$(MAKEFLAGS))),)
  quiet = silent_
endif

# ========== cmd 宏：输出短日志 + 执行命令 ==========
# 用法：
#   quiet_cmd_cc_o_c = CC      $@
#         cmd_cc_o_c = $(CC) $(c_flags) -c -o $@ $<
#   $(call cmd,cc_o_c)
#
# 执行效果（V=0）：
#     CC      build/init/main.o
# 执行效果（V=1）：
#     x86_64-linux-gnu-gcc -c -ffreestanding ... -o build/init/main.o init/main.c

cmd = @$(if $($(quiet)cmd_$(1)),\
	printf '  %-7s %s\n' '$($(quiet)cmd_$(1))' '$@' &&) \
	$(cmd_$(1))
