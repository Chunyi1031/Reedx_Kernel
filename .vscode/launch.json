{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "QEMU Kernel Debug (attach)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/kernel.elf",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "/usr/bin/gdb",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set breakpoint at kernel entry",
                    "text": "break KernelStart",
                    "ignoreFailures": false
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "logging": {
                "engineLogging": false
            }
        }
    ]
}
