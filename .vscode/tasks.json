{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Test",
            "type": "shell",
            "command": "cd ${workspaceFolder} && make && make run",
            "isBackground": true,
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Build & Start QEMU Debug",
            "type": "shell",
            "command": "make && make run-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
